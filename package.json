{
  "name": "sammelmappe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "HTTPS=1 vite --host",
    "preview:https": "HTTPS=1 vite preview --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "catalog": "node scripts/build-catalog.mjs",
    "lint": "tsc --noEmit",
    "embeddings": "node scripts/build-embeddings.mjs",
    "emb:pull": "curl -sf -o public/catalog-emb.json https://anlactrieu.github.io/sammelmappe/catalog-emb.json && curl -sf -o public/catalog-emb.bin https://anlactrieu.github.io/sammelmappe/catalog-emb.bin",
    "releases": "node scripts/build-releases.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
